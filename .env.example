TZ=Asia/Shanghai
REDIS_URL=redis://redis:6379/5
PROJECT_HOST_DIR=/opt/netease-musician-task

SEND_TIME=09:30
EXECUTION_INTERVAL_DAYS=7
MAX_MONTHLY_SENDS=4
LOGIN_METHOD=playwright
PLAYWRIGHT_PROFILE_BASEDIR=playwright_profiles
PLAYWRIGHT_PROFILE_PER_USER=1
SECONDARY_VERIFY_METHOD=sms

COOKIE_EXPIRE_DAYS=7
COOKIE_NOTIFY_BEFORE_DAYS=1

# Enterprise WeCom robot key. Paste only the value after `key=`.
WECOM_WEBHOOK_KEY=

# Optional custom webhook. If set, it takes precedence over WECOM_WEBHOOK_KEY.
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_METHOD=POST
CUSTOM_WEBHOOK_HEADERS=

# Change this before exposing the admin panel.
ADMIN_PANEL_PASSWORD=change-me
